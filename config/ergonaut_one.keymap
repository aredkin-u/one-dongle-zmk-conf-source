#include "keys_ru.h"
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        cap_sen: cap_sen {
            compatible = "zmk,behavior-hold-tap";
            label = "CAP_SEN";
            bindings = <&mo>, <&mkp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            hold-while-undecided;
        };
    };

    combos {
        compatible = "zmk,combos";

        cmben {
            bindings = <&layer_en>;
            key-positions = <38 5>;
            layers = <1>;
        };

        cmbru {
            bindings = <&layer_ru>;
            key-positions = <38 5>;
            layers = <0>;
        };

        LRPar {
            bindings = <&LR_Par>;
            key-positions = <7 8>;
            layers = <3 4 1 0>;
        };

        lr_brc {
            bindings = <&LR_brc>;
            key-positions = <19 20>;
            layers = <3 0>;
        };

        en_Lr_Brc {
            bindings = <&enBrct>;
            key-positions = <19 20>;
            layers = <1 4>;
        };

        lr_brs {
            bindings = <&LR_brs>;
            key-positions = <31 32>;
            layers = <0 3>;
        };

        en_lr_Brs {
            bindings = <&en_LR_brs>;
            key-positions = <31 32>;
            layers = <1 4>;
        };

        lr_uDQT {
            bindings = <&LR_ruDKT>;
            key-positions = <6 7>;
            layers = <1 4>;
        };

        lr_enDQT {
            bindings = <&LR_enDKT>;
            key-positions = <6 7>;
            layers = <0 3>;
        };

        boot_l {
            bindings = <&boot_lo>;
            key-positions = <11 23>;
            layers = <2>;
        };

        R_sh {
            bindings = <&kp RSHIFT>;
            key-positions = <18 19>;
            layers = <0 1>;
        };

        L_sh {
            bindings = <&kp LSHFT>;
            key-positions = <16 17>;
        };

        u_del {
            bindings = <&del_>;
            key-positions = <30 31>;
        };

        u_ent {
            bindings = <&ent_>;
            key-positions = <32 33>;
        };

        tun_toFkeys {
            bindings = <&to_Fkeys>;
            key-positions = <28 29>;
            layers = <0 1 2>;
        };

        pss {
            bindings = <&pss>;
            key-positions = <41 40>;
            layers = <0>;
        };
    };

    macros {
        to_ru: to_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&sk LS(LEFT_CONTROL)>, <&macro_wait_time 300>, <&kp N2>;

            label = "TO_RU";
            wait-ms = <20>;
            tap-ms = <60>;
        };

        to_en: to_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&sk LS(LCTRL)>, <&macro_wait_time 300>, <&kp N1>;

            label = "TO_EN";
            wait-ms = <20>;
            tap-ms = <60>;
        };

        to_ru_fast: to_ru_fast {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&sk LS(LC(N2))>;
            label = "TO_RU_FAST";
            wait-ms = <20>;
            tap-ms = <60>;
        };

        to_en_fast: to_en_fast {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&sk LS(RC(N1))>;
            label = "TO_EN_FAST";
            wait-ms = <20>;
            tap-ms = <60>;
        };

        layer_en: layer_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to_en &to 0>;
            label = "LAYER_EN";
            wait-ms = <0>;
            tap-ms = <60>;
        };

        layer_ru: layer_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to_ru &to 1>;
            label = "LAYER_RU";
            tap-ms = <60>;
            wait-ms = <0>;
        };

        en: en {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&to_en_fast>,
                <&macro_wait_time 5>,
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&to_ru_fast>;

            label = "EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        LR_Par: LR_Par {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LPAR &kp RPAR &kp LEFT_ARROW>;
            label = "LR_PAR";
        };

        LR_brc: LR_brc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBKT &kp RBKT &kp LEFT_ARROW>;
            label = "LR_BRC";
        };

        enBrct: enBrct {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to_en_fast &kp LEFT_BRACKET &kp RIGHT_BRACKET &kp LEFT_ARROW &to_ru_fast>;
            label = "ENBRCT";
        };

        LR_brs: LR_brs {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACE &kp RIGHT_BRACE &kp LEFT_ARROW>;
            label = "LR_BRS";
        };

        en_LR_brs: en_LR_brs {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to_en_fast &kp LEFT_BRACE &kp RIGHT_BRACE &kp LEFT_ARROW &to_ru_fast>;
            label = "EN_LR_BRS";
        };

        LR_ruDKT: LR_ruDKT {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RU_DOUBLE_QUOTES &kp RU_DOUBLE_QUOTES &kp LEFT_ARROW>;
            label = "LR_RUDKT";
        };

        LR_enDKT: LR_enDKT {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DQT &kp DQT &kp LEFT_ARROW>;
            label = "LR_ENDKT";
        };

        boot_lo: bootl {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bootloader>;
            label = "BOOTL";
        };

        del_: bsps_ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DELETE>;
            label = "BSPS_";
        };

        ent_: ent_ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ENTER>;
            label = "ENT_";
        };

        to_Fkeys: to_Fkeys {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&tog 2>;
            label = "TO_FKEYS";
        };

        pss: pss {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(R) &kp I &kp Y &kp N2 &kp N1 &kp N4 &kp LS(B) &kp L &kp A &kp U &kp N6 &kp N2 &kp LS(V) &kp V>;
            label = "PSS";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        en {
            display-name = "Base";
            bindings = <
&lt 2 ESC         &kp Q  &kp W  &kp E  &kp R      &kp T      &kp Y  &kp U          &kp I  &kp O  &kp P    &none
&mt CAPSLOCK TAB  &kp A  &kp S  &kp D  &kp F      &kp G      &kp H  &kp J          &kp K  &kp L  &none    &kp SLASH
&kp LALT          &kp Z  &kp X  &kp C  &kp V      &kp B      &kp N  &kp M          &none  &none  &kp DOT  &kp COMMA
                                &mo 7  &kp LCTRL  &kp SPACE  &mo 3  &kp BACKSPACE  &mo 2
            >;
        };

        ru {
            display-name = "Ru";
            bindings = <
&lt 2 ESC         &kp RU_CYRILLIC_SHORT_I  &kp RU_CYRILLIC_TSE   &kp RU_CYRILLIC_U   &kp RU_CYRILLIC_KA  &kp RU_CYRILLIC_IE  &kp RU_CYRILLIC_EN  &kp RU_CYRILLIC_GHE        &kp RU_CYRILLIC_SHA  &kp RU_CYRILLIC_SHCHA  &kp RU_CYRILLIC_ZE   &kp RU_CYRILLIC_HA
&mt CAPSLOCK TAB  &kp RU_CYRILLIC_EF       &kp RU_CYRILLIC_YERU  &kp RU_CYRILLIC_VE  &kp RU_CYRILLIC_A   &kp RU_CYRILLIC_PE  &kp RU_CYRILLIC_ER  &kp RU_CYRILLIC_O          &kp RU_CYRILLIC_EL   &kp RU_CYRILLIC_DE     &kp RU_CYRILLIC_ZHE  &kp RU_CYRILLIC_E
&kp LALT          &kp RU_CYRILLIC_YA       &kp RU_CYRILLIC_CHE   &kp RU_CYRILLIC_ES  &kp RU_CYRILLIC_EM  &kp RU_CYRILLIC_I   &kp RU_CYRILLIC_TE  &kp RU_CYRILLIC_SOFT_SIGN  &kp RU_CYRILLIC_BE   &kp RU_CYRILLIC_YU     &kp RU_DOT           &kp RU_COMMA
                                                                 &mo 6               &kp LEFT_CONTROL    &kp SPACE           &mo 4               &kp BACKSPACE              &mo 2
            >;
        };

        F_key {
            display-name = "F keys";
            bindings = <
&none     &kp F1      &kp F2  &kp F3  &kp F4            &kp F5   &kp N7        &kp N8        &kp N9        &kp NUMBER_0       &none  &none
&kp F6    &kp F7      &kp F8  &kp F9  &kp F10           &kp F11  &kp NUMBER_4  &kp NUMBER_5  &kp N6        &kp RIGHT_CONTROL  &none  &none
&kp LALT  &kp LSHIFT  &none   &none   &none             &kp F12  &kp NUMBER_1  &kp N2        &kp NUMBER_3  &kp RSHIFT         &none  &none
                              &trans  &kp LEFT_CONTROL  &trans   &trans        &trans        &trans
            >;
        };

        sym_en {
            display-name = "Symbols en";
            bindings = <
&kp AT    &kp HASH   &kp PRCNT  &kp CARET  &kp AMPS  &none     &kp LT            &kp GT             &kp LPAR   &kp RPAR   &kp PLUS   &kp MINUS
&kp HASH  &kp TILDE  &kp GRAVE  &kp SQT    &kp DQT   &kp DLLR  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LBRC   &kp RBRC   &kp ASTRK  &kp FSLH
&kp LALT  &kp BSLH   &kp PIPE   &kp FSLH   &none     &kp EXCL  &kp QUESTION      &none              &kp UNDER  &kp EQUAL  &kp COLON  &kp SEMICOLON
                                &trans     &trans    &trans    &trans            &trans             &trans
            >;
        };

        sym_ru {
            display-name = "Symbols ru";
            bindings = <
&en AT         &en HASH          &kp PRCNT  &en CARET    &en AMPS              &kp RU_CYRILLIC_IO  &en LT            &en GT                     &kp LPAR   &kp RPAR   &kp PLUS      &kp MINUS
&kp RU_NUMERO  &en TILDE         &en GRAVE  &en SQT      &kp RU_DOUBLE_QUOTES  &en DLLR            &en LEFT_BRACKET  &en RIGHT_BRACKET          &en LBRC   &en RBRC   &kp STAR      &kp RU_FSLH
&kp LALT       &kp RU_BACKSLASH  &en PIPE   &kp RU_FSLH  &none                 &kp EXCL            &kp RU_QUESTION   &kp RU_CYRILLIC_HARD_SIGN  &kp UNDER  &kp EQUAL  &kp RU_COLON  &kp RU_SEMI
                                            &trans       &trans                &trans              &trans            &trans                     &trans
            >;
        };

        adj {
            display-name = "Adjust";
            bindings = <
&bootloader  &none  &kp F1  &kp F2   &kp F3   &kp F4   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2      &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR
&none        &none  &kp F5  &kp F6   &kp F7   &kp F8   &out OUT_BLE  &kp C_VOL_DN  &kp K_MUTE        &kp C_VOL_UP  &none         &studio_unlock
&none        &none  &kp F9  &kp F10  &kp F11  &kp F12  &out OUT_USB  &kp K_PREV    &kp K_PLAY_PAUSE  &kp K_NEXT    &none         &none
                            &none    &none    &none    &none         &none         &none
            >;
        };

        num_ru {
            display-name = "num ru";
            bindings = <
&none     &kp PAUSE_BREAK  &kp C_VOLUME_UP    &kp UP    &kp PG_UP  &kp HOME    &kp N7        &kp NUMBER_8   &kp N9             &kp N0     &kp PLUS    &kp RU_MINUS
&none     &kp PRINTSCREEN  &kp LEFT           &kp DOWN  &kp RIGHT  &kp INS     &kp NUMBER_4  &kp N5         &kp NUMBER_6       &none      &kp STAR    &kp RU_FSLH
&kp LALT  &none            &kp C_VOLUME_DOWN  &kp C_PP  &kp PG_DN  &kp END     &kp N1        &kp N2         &kp N3             &kp EQUAL  &kp RU_DOT  &kp RU_COMMA
                                              &trans    &none      &kp LSHIFT  &kp RSHIFT    &kp RIGHT_ALT  &kp RIGHT_CONTROL
            >;
        };

        num_en {
            display-name = "num en";
            bindings = <
&none     &none  &kp C_VOLUME_UP    &kp UP    &kp PG_UP  &kp HOME    &kp N7        &kp NUMBER_8  &kp N9             &kp N0     &kp PLUS  &kp MINUS
&none     &none  &kp LEFT           &kp DOWN  &kp RIGHT  &kp INS     &kp NUMBER_4  &kp N5        &kp NUMBER_6       &none      &kp STAR  &kp FSLH
&kp LALT  &none  &kp C_VOLUME_DOWN  &kp C_PP  &kp PG_DN  &kp END     &kp N1        &kp N2        &kp N3             &kp EQUAL  &kp DOT   &kp COMMA
                                    &trans    &none      &kp LSHIFT  &kp RSHIFT    &kp RALT      &kp RIGHT_CONTROL
            >;
        };

        layer_8 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
